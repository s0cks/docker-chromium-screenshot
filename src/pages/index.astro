---
import { pad } from '../lib/dossier.js';
const dossierFiles = import.meta.glob('../../cards/**/*.mdc');
const dossiers = await Promise.all(
  Object.entries(dossierFiles).map(async ([filePath, resolveFile]) => {
    const module = await resolveFile() as any;
    const payload = module.default;
    const id = filePath.split('/').pop()?.replace('.mdc', '') || 'unknown';
    return {
      id,
      ...payload,
    };
  })
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Dossiers</title>
    <style>
      body { font: 16px/1.5 ui-sans-serif, system-ui, sans-serif; max-width: 46rem; margin: 3rem auto; padding: 0 1rem; color: #100f0f; }
      @media (prefers-color-scheme: dark) { body { background: #100f0f; color: #cecdc3; } a { color: #da702c; } }
      h1 { font-size: 1.4rem; } h2 { font-size: 1.1rem; margin-top: 2rem; }
      li { margin: 0.2rem 0; } small { color: #878580; }
    </style>
  </head>
  <body>
    <h1>Dossiers</h1>
    {dossiers.map((d) => (
      <section>
        <h2>{d.meta.title ?? "Test"} <small>{d.id} &middot; {d.meta.size[0]}x{d.meta.size[1]} &middot; {d.meta.theme}</small></h2>
        <ol>
          {d.slide.panels.map((s) => (
            <li>
              <a href={`/${d.id}`}>{d.meta.title ?? 'Untitled'}</a>
              {' '}<a href={`/${d.id}?theme=${d.meta.theme === 'dark' ? 'light' : 'dark'}`}><small>{d.meta.theme === 'dark' ? 'light' : 'dark'}</small></a>
              <small> &middot; {s.words} words</small>
            </li>
          ))}
        </ol>
        {d.warnings && d.warnings.map((w) => <p><small>warning: {w}</small></p>)}
      </section>
    ))}
  </body>
</html>
