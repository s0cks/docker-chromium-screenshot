---
import Block from './Block.astro';
import Colophon from './chrome/Colophon.astro';
import Masthead from './chrome/Masthead.astro';

const { dossier, slide } = Astro.props;
const { meta, slides, size } = dossier;
const nodes = [...slide.lead, ...slide.main];

const full = slide.layout === 'full';
const nodeWidth = (n) => (n.kind === 'block' && n.attrs.w === 'half' ? 'half' : undefined);

let sizeProfile = 'landscape';
if (size.width === 1200 && size.height === 1200) {
  sizeProfile = 'square';
} else if (size.width === 1080 && size.height === 1920) {
  sizeProfile = 'vertical';
}

const provenance = meta.provenance
  ? [meta.ref, (process.env.GITHUB_SHA ?? process.env.DOSSIER_COMMIT ?? 'local').slice(0, 7), new Date(Number(process.env.SOURCE_DATE_EPOCH ?? Date.now() / 1000) * 1000).toISOString().slice(0, 10)]
      .filter(Boolean)
      .join('  \u00b7  ')
  : '';
---
<Masthead author={meta.author}
          logo={meta.logo}
          index={slide.index}
          total={slides.length} 
          title={slide.title} />

<article
  class="grid grid-1x1"
  id="slide"
  data-dossier={dossier.id}
  data-slide={slide.index + 1}
  data-size={sizeProfile} >

  {nodes.map((n) => n.kind === 'md' ?
      <div class="prose" set:html={n.html} /> :
      <Block node={n} />)}
</article>

<Colophon series={meta.series}
          license={meta.license}
          provenance={provenance}
          commit='721d9a2'
          timestamp={(new Date().toISOString())}
          link={meta.link} />
