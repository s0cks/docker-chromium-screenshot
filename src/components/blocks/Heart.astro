---
interface Props {
  hash: string;
  color?: string;
}

import {generateHeartHashSVG} from '../../lib/heart.js';

const { hash, color = '#d32f2f', } = Astro.props;
const h = generateHeartHashSVG(hash, color);
---
<div class="heart" set:html={h} />
<style lang="scss">
  div.heart {
    display: block;
    width: 100%;
    min-width: 32px;
    max-width: 128px;
    aspect-ratio: 1;
  }
</style>
