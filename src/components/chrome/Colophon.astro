---
import Qr from '../blocks/Qr.astro';
import Heart from '../blocks/Heart.astro';
import Shield from '../blocks/Shield.astro';

interface Props {
  provenance?: string,
  license?: string,
  link?: string,
}

const {
  provenance = '',
  license = '',
  link = '',
} = Astro.props;

const qrData = {
  link: link,
  size: 3,
};
---
<footer class="colophon">
  <div class="prov">
    {license &&
      <span class="license">{license}</span>}
  </div>

  <div class="vault">
    <Shield />
    <Heart />

    {link && 
      <div class="gateway-qr">
        <Qr data={qrData} />
      </div>}
  </div>
</footer>
