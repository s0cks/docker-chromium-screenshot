---
interface Props { series: string; handle?: string; provenance?: string }
const { series, handle = '', provenance = '' } = Astro.props;
// Trailing digits of a handle pick up the accent colour: u/Some_Name_2184
const m = handle.match(/^(.*?)(\d+)$/);
---
<footer class="colophon">
  <span>{series}</span>
  {provenance && <span class="prov">{provenance}</span>}
  {handle && (
    <span class="handle">{m ? <>{m[1]}<b>{m[2]}</b></> : handle}</span>
  )}
</footer>
