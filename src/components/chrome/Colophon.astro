---
import Qr from '../blocks/Qr.astro';
import Heart from '../blocks/Heart.astro';
import Shield from '../blocks/Shield.astro';

interface Props {
  provenance?: string,
  license?: string,
  link?: string,
  commit?: string,
  timestamp?: string,
}

const {
  provenance = '',
  license = '',
  link = '',
  commit = '',
  timestamp = '',
} = Astro.props;
---
<footer class="colophon">
  <div class="prov">
    {license &&
      <span class="license">{license}</span>}

    {commit &&
      <span class="commit">{commit}</span>}

    {timestamp &&
      <span class="timestamp">{timestamp}</span>}
  </div>

  <div class="vault">
    {link && 
      <div class="gateway-qr">
        <Qr data={{
              link: link,
              size: 3,
            }} />
      </div>}
  </div>
</footer>
