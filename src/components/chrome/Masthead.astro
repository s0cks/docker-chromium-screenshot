---
import Author from './Author.astro';
import { pad } from '../../lib/dossier.js';
interface Props { series: string; logo?: string | null; index: number; total: number }
const { series, logo, index, total, author = '', } = Astro.props;
const logoSrc = logo && !/^(\/|https?:|data:)/.test(logo) ? `/${logo}` : logo;
import Logo from '../../assets/logo.svg';
---
<header class="masthead">
  {logoSrc &&
    <img class="logo"
         src={logoSrc}
         alt="" />}
  {!logoSrc &&
    <div class="logo">
      <Logo />
    </div>}

  <div class="brand">

    <span class="series">{series}</span>
  </div>

  <div class="info">
    {author && (
      <Author author={author} />
    )}
    <span class="pager">{pad(index + 1)}/{pad(total)}</span>
  </div>
</header>
